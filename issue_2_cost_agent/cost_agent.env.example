# Copy to issue_2_cost_agent/cost_agent.env (gitignored by the root *.env rule) and add your key.
# Same variable names as apps/api/.env, so these lines move over unchanged at integration.

# meta = Meta Model API (Muse). none = deterministic fallbacks only, no network.
LLM_PROVIDER=meta
LLM_API_KEY=
LLM_MODEL=muse-spark-1.3

# Optional overrides
# LLM_BASE_URL=https://api.meta.ai/v1
# LLM_TIMEOUT_SECONDS=15
# LLM_REASONING_EFFORT=minimal
# LLM_MAX_TOKENS=1000
