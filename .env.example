# Copy to apps/api/.env

# true = use cached fixtures, no external calls (default for development)
USE_FIXTURES=true

# Capital One Nessie  (http://api.nessieisreal.com)
NESSIE_API_KEY=
NESSIE_BASE_URL=http://api.nessieisreal.com

# LLM (any provider; see app/clients/llm.py).
#   LLM_PROVIDER=muse  LLM_MODEL=muse-spark-1.3
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
# Tried in order when LLM_MODEL fails transiently (muse-spark-1.3 sometimes 404s).
# Empty uses muse-spark-1.2 for muse/meta.
LLM_FALLBACK_MODELS=

# Cache DB
DATABASE_URL=sqlite:///./cache.sqlite3

# CORS
WEB_ORIGIN=http://localhost:3000
# Comma-separate extra origins, e.g. WEB_ORIGIN=https://your-app.vercel.app,http://localhost:3000
# Any https://*.vercel.app origin is also allowed via WEB_ORIGIN_REGEX (set empty to disable).
