# Copy to apps/api/.env

# true = use cached fixtures, no external calls (default for development)
USE_FIXTURES=true

# Capital One Nessie  (http://api.nessieisreal.com)
NESSIE_API_KEY=
NESSIE_BASE_URL=http://api.nessieisreal.com

# SerpApi  (https://serpapi.com)
SERPAPI_API_KEY=

# LLM, shared by the Cost Agent, PFO Agent, and Explanation Agent (app/clients/llm.py).
# none = deterministic fallbacks only, no network. meta = Meta Model API (Muse).
# Other OpenAI-compatible providers: openai, llama, groq, openrouter, gemini, or set LLM_BASE_URL.
LLM_PROVIDER=none
LLM_API_KEY=
# Empty = provider default (meta: muse-spark-1.3, https://api.meta.ai/v1, reasoning effort minimal)
LLM_MODEL=
# LLM_BASE_URL=
# LLM_REASONING_EFFORT=minimal
# LLM_MAX_TOKENS=1000
# LLM_TIMEOUT_SECONDS=20
# LLM_CACHE_PATH=llm_cache.sqlite3
# Check a live key: cd apps/api && .venv/bin/python -m scripts.llm_smoke_check

# Cache DB
DATABASE_URL=sqlite:///./cache.sqlite3

# CORS
WEB_ORIGIN=http://localhost:3000
