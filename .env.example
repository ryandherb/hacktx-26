# Copy to apps/api/.env

# true = use cached fixtures, no external calls (default for development)
USE_FIXTURES=true

# Capital One Nessie  (http://api.nessieisreal.com)
NESSIE_API_KEY=
NESSIE_BASE_URL=http://api.nessieisreal.com

# LLM (any provider; see app/clients/llm.py).
#   LLM_PROVIDER=muse  LLM_MODEL=muse-spark-1.3
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# Cache DB
DATABASE_URL=sqlite:///./cache.sqlite3

# CORS
WEB_ORIGIN=http://localhost:3000
